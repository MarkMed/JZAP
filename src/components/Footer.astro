---
import jzapMax from "../assets/jzapMax.png";
---

<footer class="footer">
  <div class="container footer-container">
    <div class="footer-col footer-explore">
      <h3 class="footer-title">Explore</h3>
      <nav class="footer-links">
        <a href="#">Home</a>
        <a href="#services">Services</a>
        <a href="#expertise">Expertise</a>
        <a href="#contact">Contact</a>
      </nav>
    </div>

    <div class="footer-col footer-disclaimer">
      <h3 class="footer-title">A personal brand. Real expertise.</h3>
      <p class="disclaimer-text">
        JZAP is the personal brand of <a
          class="footer-link"
          href="https://www.linkedin.com/in/marcos-a-medina/"
          >Marcos Medina (MarkMed)</a
        >, built around software development, design, and technical consulting.
        Services are provided directly by Marcos as an independent professional
        — not by a separate company.
      </p>
      <span class="disclaimer-highlight"
        >Independent today. Built to grow tomorrow.</span
      >
    </div>

    <div class="footer-col footer-logo-col">
      <img src={jzapMax.src} alt="JZAP Logo" class="footer-logo" />
    </div>
  </div>
  <div class="footer-bottom">
    <p>
      &copy; {new Date().getFullYear()} JZAP (Marcos Medina). All rights reserved.
    </p>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-mystic);
    border-top: 1px solid var(--surface-container-high);
    padding: var(--spacing-xl) 0 var(--spacing-md);
  }

  .footer-container {
    display: grid;
    grid-template-columns: 1fr 2fr 1fr;
    gap: var(--spacing-xl);
    align-items: center;
    margin-bottom: var(--spacing-xl);
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }

  .footer-title {
    font-size: 18px;
    font-weight: 700;
    color: var(--on-background);
    margin-bottom: var(--spacing-xs);
  }

  .footer-explore {
    align-items: flex-start;
  }

  .footer-links {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }

  .footer-links a {
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--on-surface-variant);
    transition: color 0.2s ease;
  }

  .footer-links a:hover {
    color: var(--primary);
  }

  .footer-disclaimer {
    border-left: 1px solid var(--surface-container-high);
    border-right: 1px solid var(--surface-container-high);
    padding: 0 var(--spacing-lg);
  }

  .disclaimer-text {
    font-size: 14px;
    color: var(--on-surface-variant);
    line-height: 1.6;
  }

  .disclaimer-highlight {
    display: inline-block;
    font-family: var(--font-brand);
    font-size: 14px;
    font-weight: 600;
    color: var(--primary);
    margin-top: var(--spacing-xs);
  }

  .footer-logo-col {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .footer-logo {
    max-width: 250px;
    height: auto;
    transition: opacity 0.2s ease;
  }

  .footer-bottom {
    text-align: center;
    border-top: 1px solid var(--surface-container-high);
    padding-top: var(--spacing-md);
    font-size: 12px;
    color: var(--on-surface-variant);
  }

  @media (max-width: 900px) {
    .footer-container {
      grid-template-columns: 1fr;
      text-align: center;
      gap: var(--spacing-lg);
    }

    .footer-explore {
      align-items: center;
    }

    .footer-disclaimer {
      border: none;
      border-top: 1px solid var(--surface-container-high);
      border-bottom: 1px solid var(--surface-container-high);
      padding: var(--spacing-md) 0;
    }
  }
</style>
