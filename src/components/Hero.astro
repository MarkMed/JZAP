---
---
<section class="hero">
  <div class="container hero-container">
    <h1 class="display-title">
      A DAZZLING SUPPORT FOR<br/>YOUR PROJECT
    </h1>
    <div class="hero-description">
      <p>More than just coding: we provide strategic support, empowering your idea with</p>
      <p>robust, scalable architecture — making sure your project works flawlessly and</p>
      <p>looks amazing.</p>
      <p class="highlight"><strong>Let's make your project to dazzle!</strong></p>
    </div>
    <div class="hero-actions">
      <a href="#contact" class="btn btn-secondary">Contact</a>
      <a href="#services" class="btn btn-primary">Services</a>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-top: 80px;
    position: relative;
    overflow: hidden;
  }
  
  .hero::before {
    content: '';
    position: absolute;
    top: -20%;
    right: -10%;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(204, 61, 151, 0.15) 0%, rgba(15, 8, 23, 0) 70%);
    border-radius: 50%;
    z-index: -1;
  }
  
  .hero-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 900px;
  }
  
  .display-title {
    font-size: 56px;
    line-height: 1.1;
    margin-bottom: var(--spacing-xl);
    text-transform: uppercase;
  }
  
  .hero-description {
    font-size: 16px;
    color: var(--on-surface-variant);
    margin-bottom: var(--spacing-xl);
    line-height: 1.5;
  }
  
  .hero-description p {
    margin: 0;
  }
  
  .hero-description .highlight {
    margin-top: var(--spacing-md);
    color: var(--on-surface);
  }
  
  .hero-actions {
    display: flex;
    gap: var(--spacing-md);
    justify-content: center;
  }
  
  .btn {
    min-width: 140px;
  }

  @media (max-width: 900px) {
    .display-title {
      font-size: 40px;
    }
    
    .hero-actions {
      flex-direction: column;
      width: 100%;
      max-width: 300px;
    }
  }
</style>
