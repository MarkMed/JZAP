---
import { Icon } from 'astro-icon/components';
---
<section id="services" class="services-section">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">Services</h2>
      <p class="section-subtitle">Upgrade your product. Strengthen your foundation. Grow smarter.</p>
    </div>
    
    <div class="services-grid">
      <div class="card service-card">
        <div class="service-icon-wrapper">
          <Icon name="lucide:layout" class="service-icon" />
        </div>
        <h3 class="service-title">UI/UX Design and Development</h3>
        <p class="service-text">Get beautiful, high-performing interfaces that feel intuitive and look stunning. Your users will enjoy smooth navigation, polished visuals, and a product that stands out on any device. Design and development, fused to deliver real impact.</p>
        <a href="#" class="service-link">Elevate your UI <Icon name="lucide:arrow-right" /></a>
      </div>

      <div class="card service-card">
        <div class="service-icon-wrapper">
          <Icon name="lucide:network" class="service-icon" />
        </div>
        <h3 class="service-title">Software Architecture & Consulting</h3>
        <p class="service-text">Get evaluation, design or refactor for your project's architecture to make it robust and scalable. Clear structure, optimized performance, and technical decisions that support the future of your business.</p>
        <a href="#" class="service-link">Get Scalability <Icon name="lucide:arrow-right" /></a>
      </div>

      <div class="card service-card">
        <div class="service-icon-wrapper">
          <Icon name="lucide:code" class="service-icon" />
        </div>
        <h3 class="service-title">FullStack Development</h3>
        <p class="service-text">Build your idea with solid, scalable connections between frontend and backend. Get modular APIs, clean integrations, and fast, secure performance — all designed to grow with your product.</p>
        <a href="#" class="service-link">Build Your Idea <Icon name="lucide:arrow-right" /></a>
      </div>

      <div class="card service-card">
        <div class="service-icon-wrapper">
          <Icon name="lucide:milestone" class="service-icon" />
        </div>
        <h3 class="service-title">Software Engineering & Management</h3>
        <p class="service-text">Define a clear technical path for your project, based on real engineering. Transform your goals into strategic decisions, reduce risks, manage stakeholders and align your team with targets. Improve efficiency, boost profits.</p>
        <a href="#" class="service-link">Define Your Path <Icon name="lucide:arrow-right" /></a>
      </div>
    </div>
  </div>
</section>

<style>
  .services-section {
    padding: var(--spacing-xl) 0;
  }
  


  .services-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-xl);
  }
  
  .service-card {
    display: flex;
    flex-direction: column;
    padding: var(--spacing-xl) var(--spacing-lg);
    background: var(--surface-container-low);
    border: 1px solid var(--surface-container-high);
  }
  
  .service-icon-wrapper {
    display: flex;
    justify-content: center;
    margin-bottom: var(--spacing-md);
  }
  
  .service-icon {
    width: 32px;
    height: 32px;
    color: var(--on-surface-variant);
  }
  
  .service-title {
    text-align: center;
    font-size: 24px;
    margin-bottom: var(--spacing-md);
    color: var(--on-surface);
  }
  
  .service-text {
    font-size: 16px;
    color: var(--on-surface-variant);
    line-height: 1.7;
    margin-bottom: var(--spacing-lg);
  }
  
  .service-link {
    margin-top: auto;
    align-self: flex-end;
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
    font-size: 14px;
    font-family: var(--font-brand);
    font-weight: 500;
    color: var(--on-surface);
    transition: color 0.2s ease;
  }
  
  .service-link svg {
    width: 16px;
    height: 16px;
    transition: transform 0.2s ease;
  }
  
  .service-card:hover .service-link {
    color: var(--primary);
  }
  
  .service-card:hover .service-link svg {
    transform: translateX(4px);
  }

  @media (max-width: 900px) {
    .services-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
