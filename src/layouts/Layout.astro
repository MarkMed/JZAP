---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const { 
  title = "JZAP | Critical Operational Support", 
  description = "High-stakes IT solutions, DevOps and Fullstack Development. Over 8 years of operational excellence." 
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		
		<!-- SEO -->
		<title>{title}</title>
		<meta name="description" content={description} />
	</head>
	<body>
		<slot />
	</body>
</html>
