---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <header class="navbar">
    <div class="container nav-container">
      <div class="logo">
        <span class="logo-text">JZAP</span>
        <span class="logo-dot"></span>
      </div>
      <nav class="nav-links">
        <a href="#services">Services</a>
        <a href="#expertise">Expertise</a>
        <a href="#contact" class="btn btn-secondary">Contact Operator</a>
      </nav>
    </div>
  </header>

  <main>
    <section class="hero">
      <div class="container hero-container">
        <div class="hero-content">
          <p class="slogan">Critical Operational Support</p>
          <h1 class="display-title">
            Engineering the <span class="text-gradient">Shadow Wave</span> of the Web
          </h1>
          <p class="hero-description">
            Over 8 years of high-precision Fullstack Development and DevOps. 
            We build robust, scalable infrastructure that works relentlessly in the dark, 
            so your business can shine in the light.
          </p>
          <div class="hero-actions">
            <a href="#services" class="btn btn-primary">Initialize Protocol</a>
            <a href="#expertise" class="btn btn-secondary">View Capabilities</a>
          </div>
        </div>
        
        <div class="hero-visual">
          <div class="portal-ring">
            <div class="portal-core">
              <span class="status-indicator"></span>
              <p class="status-text">System Active</p>
            </div>
          </div>
        </div>
      </div>
    </section>
    
    <section id="services" class="services">
      <div class="container">
        <h2 class="section-title">Operational Services</h2>
        <div class="services-grid">
           <!-- Cards will go here in the next iteration -->
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  /* Header */
  .navbar {
    position: fixed;
    top: 0;
    width: 100%;
    padding: var(--spacing-md) 0;
    background: rgba(26, 4, 22, 0.85);
    backdrop-filter: blur(12px);
    z-index: 100;
    border-bottom: 1px solid var(--surface-container-high);
  }
  
  .nav-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  
  .logo {
    display: flex;
    align-items: baseline;
    gap: var(--spacing-xs);
  }
  
  .logo-text {
    font-family: var(--font-brand);
    font-size: 24px;
    font-weight: 700;
    letter-spacing: -0.05em;
    color: var(--on-background);
  }
  
  .logo-dot {
    width: 6px;
    height: 6px;
    background-color: var(--electric-flash);
    border-radius: var(--rounded-full);
    box-shadow: 0 0 8px var(--electric-flash);
  }
  
  .nav-links {
    display: flex;
    align-items: center;
    gap: var(--spacing-lg);
  }
  
  .nav-links a:not(.btn) {
    font-family: var(--font-brand);
    font-size: 14px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--on-surface-variant);
  }
  
  .nav-links a:not(.btn):hover {
    color: var(--primary);
  }
  
  /* Hero Section */
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding-top: 80px;
    position: relative;
    overflow: hidden;
  }
  
  .hero::before {
    content: '';
    position: absolute;
    top: -20%;
    right: -10%;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(168, 21, 155, 0.15) 0%, rgba(26, 4, 22, 0) 70%);
    border-radius: 50%;
    z-index: -1;
  }
  
  .hero-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-xl);
    align-items: center;
  }
  
  .slogan {
    font-family: var(--font-brand);
    font-weight: 500;
    font-size: 14px;
    color: var(--primary);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin-bottom: var(--spacing-md);
    display: inline-block;
    border: 1px solid var(--surface-container-high);
    padding: var(--spacing-xs) var(--spacing-sm);
    border-radius: var(--rounded-sm);
    background: var(--surface-container-lowest);
  }
  
  .display-title {
    font-size: 64px;
    line-height: 1.05;
    margin-bottom: var(--spacing-lg);
  }
  
  .hero-description {
    font-size: 18px;
    color: var(--on-surface-variant);
    max-width: 90%;
    margin-bottom: var(--spacing-xl);
  }
  
  .hero-actions {
    display: flex;
    gap: var(--spacing-md);
  }
  
  /* Portal Visual */
  .hero-visual {
    display: flex;
    justify-content: center;
    align-items: center;
  }
  
  .portal-ring {
    width: 380px;
    height: 380px;
    border-radius: 50%;
    border: 1px dashed var(--outline-variant);
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    animation: spin 30s linear infinite;
  }
  
  .portal-ring::before {
    content: '';
    position: absolute;
    inset: -20px;
    border-radius: 50%;
    border: 1px solid transparent;
    border-top-color: var(--shadow-wave);
    border-bottom-color: var(--electric-flash);
    opacity: 0.3;
    animation: spin 15s linear infinite reverse;
  }
  
  .portal-core {
    width: 240px;
    height: 240px;
    background: var(--surface-container);
    border-radius: 50%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: var(--spacing-sm);
    box-shadow: 0 0 40px rgba(168, 21, 155, 0.2);
    animation: pulse 4s ease-in-out infinite alternate;
  }
  
  /* Prevent inner content from spinning */
  .portal-core > * {
    animation: spin 30s linear infinite reverse;
  }
  
  .status-indicator {
    width: 12px;
    height: 12px;
    background-color: var(--electric-flash);
    border-radius: 50%;
    box-shadow: 0 0 12px var(--electric-flash);
  }
  
  .status-text {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 14px;
    color: var(--on-background);
    letter-spacing: 0.05em;
  }
  
  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
  
  @keyframes pulse {
    from { box-shadow: 0 0 20px rgba(168, 21, 155, 0.1); }
    to { box-shadow: 0 0 60px rgba(160, 35, 200, 0.4); }
  }
  
  /* Services temp */
  .services {
    padding: var(--spacing-xl) 0;
    min-height: 50vh;
  }
  
  .section-title {
    font-size: 40px;
    text-align: center;
    margin-bottom: var(--spacing-xl);
  }

  @media (max-width: 900px) {
    .hero-container {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .hero-description {
      margin: 0 auto var(--spacing-xl);
    }
    .hero-actions {
      justify-content: center;
    }
    .portal-ring {
      margin-top: var(--spacing-xl);
      width: 280px;
      height: 280px;
    }
    .portal-core {
      width: 180px;
      height: 180px;
    }
    .display-title {
      font-size: 40px;
    }
  }
</style>
